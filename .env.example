# ─────────────────────────────────────────────────────────────────────────────
# Interactive Cybersecurity Lab — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Flask runtime environment: development | production | testing
FLASK_ENV=development

# Cryptographically random secret key (generate with: python -c "import secrets; print(secrets.token_hex(64))")
SECRET_KEY=REPLACE_WITH_RANDOM_64_BYTE_HEX_STRING

# PostgreSQL connection string
# Local:  postgresql://username:password@localhost:5432/cybersec_lab
# Render: set automatically from DATABASE_URL env var
DATABASE_URL=postgresql://username:password@localhost:5432/cybersec_lab

# ── Initial account provisioning ─────────────────────────────────────────────
# Used only by scripts/provision_accounts.py — never read by the running app.
ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

TESTER_USERNAME=REPLACE_WITH_TESTER_USERNAME
TESTER_EMAIL=REPLACE_WITH_TESTER_EMAIL
TESTER_PASSWORD=REPLACE_WITH_STRONG_TESTER_PASSWORD

# ── Session security ─────────────────────────────────────────────────────────
# Session lifetime in seconds (default: 3600 = 1 hour)
SESSION_LIFETIME_SECONDS=3600

# ── External-target mode ─────────────────────────────────────────────────────
# Disabled by default. Set to 'true' only after explicit administrator approval.
EXTERNAL_TARGETS_ENABLED=false

# ── PDF export ───────────────────────────────────────────────────────────────
# Directory where generated reports are stored (must be writable, outside static/)
REPORT_OUTPUT_DIR=instance/reports

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
